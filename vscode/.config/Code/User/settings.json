{
    "[dockercompose]": {
        "editor.autoIndent": "advanced",
        "editor.defaultFormatter": "redhat.vscode-yaml",
        "editor.insertSpaces": true,
        "editor.tabSize": 2
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[go]": {
        "editor.defaultFormatter": "golang.go"
    },
    "[javascript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[lua]": {
        "editor.defaultFormatter": "yinfei.luahelper"
    },
    "[python]": {
        "editor.defaultFormatter": "ms-python.autopep8"
    },
    "[terraform]": {
        "editor.defaultFormatter": "hashicorp.terraform"
    },
    "[typescript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[yaml]": {
        "editor.defaultFormatter": "redhat.vscode-yaml",
        "editor.tabSize": 2
    },
    "autopep8.args": [
        "--max-line-length=200"
    ],
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "chat.detectParticipant.enabled": true,
    "chat.renderRelatedFiles": true,
    "chat.tools.terminal.autoApprove": {
        "go": true,
        "golangci-lint": true,
        "gofmt": true,
        "KONG_VERSION=3.4.2": true,
        "make": true,
        "nmcli": true
    },
    "diffEditor.ignoreTrimWhitespace": false,
    "diffEditor.renderSideBySide": true,
    "editor.codeActionsOnSave": {},
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.detectIndentation": false,
    "editor.fontFamily": "'JetBrains Mono', 'Droid Sans Mono', 'monospace', monospace",
    "editor.fontLigatures": true,
    "editor.formatOnSaveMode": "modifications",
    "editor.inlineSuggest.enabled": true,
    "editor.stickyScroll.enabled": true,
    "evenBetterToml.formatter.alignComments": false,
    "evenBetterToml.formatter.alignEntries": true,
    "evenBetterToml.formatter.allowedBlankLines": 1,
    "evenBetterToml.formatter.arrayAutoCollapse": true,
    "evenBetterToml.formatter.arrayAutoExpand": true,
    "evenBetterToml.formatter.indentEntries": true,
    "extensions.ignoreRecommendations": true,
    "files.associations": {
        "*.gotmpl": "yaml",
        "**/keys/**/*sops.yaml": "plaintext",
        "**/roles/**/*.j2": "ansible-jinja",
        "**/roles/**/*.yaml": "ansible",
        "**/roles/**/*.yml": "ansible"
    },
    "files.watcherExclude": {
        " \"**/node_modules/**\"": true
    },
    "git.autofetch": true,
    "git.blame.editorDecoration.enabled": true,
    "git.confirmSync": false,
    "git.enableCommitSigning": true,
    "git.enableSmartCommit": true,
    "git.fetchOnPull": true,
    "git.openRepositoryInParentFolders": "always",
    "git.replaceTagsWhenPull": true,
    "github.copilot.chat.agent.thinkingTool": true,
    "github.copilot.chat.codesearch.enabled": true,
    "github.copilot.chat.editor.temporalContext.enabled": true,
    "github.copilot.chat.edits.temporalContext.enabled": true,
    "github.copilot.chat.generateTests.codeLens": true,
    "github.copilot.chat.scopeSelection": true,
    "github.copilot.chat.startDebugging.enabled": true,
    "github.copilot.enable": {
        "*": true,
        "markdown": true,
        "plaintext": true
    },
    // "github.copilot.nextEditSuggestions.enabled": false,
    "githubPullRequests.createOnPublishBranch": "never",
    "githubPullRequests.experimental.chat": true,
    "githubPullRequests.fileListLayout": "tree",
    "githubPullRequests.pullBranch": "never",
    "githubPullRequests.pushBranch": "always",
    "githubPullRequests.terminalLinksHandler": "github",
    "go.formatTool": "goimports",
    "go.lintFlags": [
        "--fast-only"
    ],
    "go.lintTool": "golangci-lint",
    "go.testTimeout": "300s",
    "go.toolsManagement.autoUpdate": true,
    "inlineChat.accessibleDiffView": "on",
    "Prettier-SQL.denseOperators": true,
    "Prettier-SQL.keywordCase": "upper",
    "prettier.bracketSpacing": false,
    "prettier.ignorePath": "/home/lucho/.prettierignore",
    "prettier.tabWidth": 4,
    "pylint.args": [
        "--max-line-length=200",
        "--rcfile=.pylintrc"
    ],
    "python.analysis.supportAllPythonDocuments": true,
    "python.createEnvironment.trigger": "off",
    "python.terminal.shellIntegration.enabled": true,
    "redhat.telemetry.enabled": false,
    "search.searchView.keywordSuggestions": true,
    "security.workspace.trust.untrustedFiles": "open",
    "shellformat.effectLanguages": [
        "shellscript",
        // "dockerfile",
        "dotenv",
        "hosts",
        "jvmoptions",
        "ignore",
        "gitignore",
        "properties",
        "spring-boot-properties",
        "azcli",
        "bats"
    ],
    "sonarlint.disableTelemetry": true,
    "telemetry.feedback.enabled": false,
    "telemetry.telemetryLevel": "off",
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "window.menuBarVisibility": "toggle",
    "window.title": "${dirty}${activeEditorShort}${separator}${rootName}${separator}${profileName}${separator}${activeRepositoryBranchName}",
    "window.titleBarStyle": "native",
    "window.zoomLevel": 0,
    // "workbench.colorTheme": "Alabaster Dark",
    "workbench.colorCustomizations": {
        "[Alabaster Dark]": {
            "list.activeSelectionBackground": "#7abbecd5",
            "list.activeSelectionForeground": "#ffffff",
            "list.inactiveSelectionBackground": "#7abbec44",
            "list.highlightForeground": "#7abbec"
        }
    },
    "workbench.settings.showAISearchToggle": true,
    "workbench.sideBar.location": "right",
    "workbench.startupEditor": "none",
    "workbench.tree.enableStickyScroll": true,
    "yaml.format.printWidth": 160,
    "yaml.schemaStore.enable": false,
    "yaml.validate": false,
    "qt-core.additionalQtPaths": [
        {
            "name": "Qt-5.15.18-linux-g++_from_PATH",
            "path": "/usr/bin/qtpaths"
        }
    ],
    "[qml]": {
        "editor.defaultFormatter": "AndreOneti.qml-formatter"
    },
    "typescript.updateImportsOnFileMove.enabled": "always",
    "github.copilot.nextEditSuggestions.enabled": true,
    "chat.mcp.gallery.enabled": true,
    "chat.customAgentInSubagent.enabled": true,
    "chat.viewSessions.orientation": "stacked",
    "python.analysis.diagnosticsSource": "Pyright",
    "workbench.browser.enableChatTools": true,
    "window.restoreWindows": "none"
}