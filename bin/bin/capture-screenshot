#!/bin/bash
# Take a screenshot: save to disk AND copy to the clipboard.
#
#   capture-screenshot [smart|region|windows|fullscreen] [both|copy|save]
#
# Default is `smart both`: pick a region by dragging, or single-click to snap to
# whatever window or monitor is under the cursor.
#
# Press the hotkey again while the picker is up to cancel.
#
# Env:
#   SHOT_DIR     output directory (default ~/Pictures/Screenshots)
#   SHOT_FORMAT  jpeg (default, matches the previous binds) or png
#   SHOT_EDITOR  annotation editor for the notification action (default satty)

set -uo pipefail

MODE=${1:-smart}
ACTION=${2:-both}

# Re-pressing the hotkey while a selection is on screen cancels it. pkill exits 0
# only if it actually signalled something, so a first press falls through.
if pkill -x slurp 2>/dev/null; then
  pkill -x hyprpicker 2>/dev/null
  exit 0
fi

DIR=${SHOT_DIR:-$HOME/Pictures/Screenshots}
FORMAT=${SHOT_FORMAT:-jpeg}
case $FORMAT in
  png) EXT=png ;;
  jpeg | jpg) FORMAT=jpeg EXT=jpg ;;
  *)
    echo "capture-screenshot: unsupported SHOT_FORMAT '$FORMAT'" >&2
    exit 1
    ;;
esac

mkdir -p "$DIR" || exit 1
FILE="$DIR/$(date +'%Y-%m-%d_%H-%M-%S').$EXT"

# --- cursor -----------------------------------------------------------------
# A software-rendered cursor is composited into the framebuffer and therefore
# ends up baked into the screenshot. Hardware cursors live on a separate plane
# and don't. Force them on for the duration and restore the previous value
# (which is 2/auto by default, not 0) on any exit path.
PREV_HW_CURSORS=$(hyprctl -j getoption cursor:no_hardware_cursors 2>/dev/null | jq -r '.int // 2')
FREEZE_PID=""

cleanup() {
  [[ -n $FREEZE_PID ]] && kill "$FREEZE_PID" 2>/dev/null
  hyprctl keyword cursor:no_hardware_cursors "$PREV_HW_CURSORS" >/dev/null 2>&1
}
trap cleanup EXIT

# --- candidate rectangles ---------------------------------------------------
# slurp snaps to any rectangle it is fed on stdin. Give it every monitor and
# every window on the active workspace so a drag has something to latch onto and
# a click can be resolved to a window.
#
# Monitors report size in PHYSICAL pixels plus a scale, while slurp works in
# LOGICAL coordinates, so divide. This machine has eDP-1 at 3200x1800 scale
# 1.3333 (= 2400x1350 logical); feeding the physical size would push the rect
# far past the right edge of the desktop. Transforms 1/3/5/7 are rotated 90/270,
# which swaps width and height.
monitor_rects() {
  hyprctl monitors -j | jq -r '
    .[] |
    (if (.transform | IN(1,3,5,7))
     then { w: (.height / .scale), h: (.width / .scale) }
     else { w: (.width / .scale),  h: (.height / .scale) }
     end) as $d |
    "\(.x),\(.y) \($d.w | round)x\($d.h | round)"
  '
}

# Client .at/.size are already logical. Restrict to the visible workspaces so a
# click never resolves to a window on another workspace.
window_rects() {
  local visible
  visible=$(hyprctl monitors -j | jq -r '[.[].activeWorkspace.id] | join(",")')
  hyprctl clients -j | jq -r --arg ws "$visible" '
    ($ws | split(",") | map(tonumber)) as $visible |
    .[] |
    select(.mapped and (.hidden | not)) |
    select(.workspace.id as $id | $visible | index($id)) |
    select(.size[0] > 0 and .size[1] > 0) |
    "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"
  '
}

freeze_screen() {
  # -r renders without picking, -z freezes the screen so nothing shifts under the
  # pointer while aiming. It must outlive slurp so grim captures the frozen frame.
  hyprpicker -r -z >/dev/null 2>&1 &
  FREEZE_PID=$!
  sleep 0.15
}

# Resolve a click (a degenerate selection) to the smallest rectangle containing
# that point, preferring windows over monitors.
rect_at_point() {
  local px=$1 py=$2
  {
    window_rects
    monitor_rects
  } | awk -v px="$px" -v py="$py" '
    {
      split($1, o, ",");  x = o[1]; y = o[2]
      split($2, s, "x");  w = s[1]; h = s[2]
      if (px >= x && px < x + w && py >= y && py < y + h) {
        area = w * h
        if (best == "" || area < bestarea) { best = $0; bestarea = area }
      }
    }
    END { if (best != "") print best }
  '
}

select_region() {
  local selection
  if [[ -n $RECTS ]]; then
    selection=$(printf '%s\n' "$RECTS" | slurp $RESTRICT 2>/dev/null)
  else
    selection=$(slurp 2>/dev/null)
  fi
  [[ -z $selection ]] && return 1

  # A selection under ~20px² is a click, not a drag. Expand it to the rect that
  # contains it so single-click-to-window works.
  local pos size x y w h
  pos=${selection%% *}
  size=${selection##* }
  x=${pos%%,*} y=${pos##*,}
  w=${size%%x*} h=${size##*x}
  if ((w * h < 20)); then
    local hit
    hit=$(rect_at_point "$x" "$y")
    [[ -n $hit ]] && selection=$hit
  fi

  printf '%s\n' "$selection"
}

# --- capture ----------------------------------------------------------------
# Which rectangles slurp gets, and whether it is confined to them. -r *restricts*
# the selection to the rectangles fed on stdin: you can only pick a whole window,
# never drag. That is the point of `windows`, but it would kill free-hand
# dragging in `smart`, where the rects are only guides — a click there is
# resolved to a window by rect_at_point instead.
RECTS="" RESTRICT=""
case $MODE in
  fullscreen) ;;
  windows) RECTS=$(window_rects) RESTRICT="-r" ;;
  region) ;;
  smart) RECTS=$({ monitor_rects; window_rects; }) ;;
  *)
    echo "capture-screenshot: unknown mode '$MODE'" >&2
    exit 1
    ;;
esac

if [[ $MODE == fullscreen ]]; then
  TARGET=$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name')
else
  # freeze_screen has to run in THIS shell, not inside the command substitution
  # below: `$( )` is a subshell, so a FREEZE_PID set in there is invisible to
  # cleanup and hyprpicker would keep the screen frozen after the shot, waiting
  # for an Escape.
  freeze_screen
  TARGET=$(select_region) || exit 0
fi
[[ -z $TARGET ]] && exit 0

hyprctl keyword cursor:no_hardware_cursors 0 >/dev/null 2>&1

if [[ $MODE == fullscreen ]]; then
  grim -t "$FORMAT" -o "$TARGET" "$FILE" || exit 1
else
  grim -t "$FORMAT" -g "$TARGET" "$FILE" || exit 1
fi

cleanup
trap - EXIT

[[ -s $FILE ]] || {
  echo "capture-screenshot: grim produced no output" >&2
  exit 1
}

case $ACTION in
  copy)
    wl-copy <"$FILE"
    rm -f "$FILE"
    notify-send -a screenshot -i "$FILE" "Screenshot copied"
    exit 0
    ;;
  save) ;;
  both | *) wl-copy <"$FILE" ;;
esac

# Offer to open the shot in an annotation editor, if one is installed. A
# libnotify action keeps this process alive until the notification is dismissed,
# so run it in the background and let the script return immediately.
EDITOR_BIN=${SHOT_EDITOR:-satty}
if command -v "$EDITOR_BIN" >/dev/null 2>&1; then
  (
    action=$(notify-send -a screenshot -i "$FILE" -t 10000 \
      -A "edit=Edit" "Screenshot saved" "${FILE##*/}")
    if [[ $action == edit ]]; then
      "$EDITOR_BIN" --filename "$FILE" --output-filename "$FILE" \
        --early-exit --actions-on-enter save-to-clipboard --copy-command wl-copy
    fi
  ) >/dev/null 2>&1 &
else
  notify-send -a screenshot -i "$FILE" "Screenshot saved" "${FILE##*/}"
fi
